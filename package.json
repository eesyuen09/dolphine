{
  "name": "dolphine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "npm --prefix backend install",
    "install:algo": "python3 -m pip install -r algorithm/requirements.txt",
    "install:all": "npm run install:frontend && npm run install:backend && npm run install:algo",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "start:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "start:algo": "cd algorithm && python3 -m uvicorn src.main:app --port 8000 --reload",
    "dev:backend": "npm --prefix backend run dev",
    "generate:listings": "npm --prefix backend run generate:listings",
    "import:99co-browser": "npm --prefix backend run import:99co-browser",
    "merge:listings": "npm --prefix backend run merge:listings",
    "receive:research": "npm --prefix backend run receive:research",
    "validate:listings": "npm --prefix backend run validate:listings"
  }
}
